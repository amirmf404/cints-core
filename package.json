{
  "name": "metacrud",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic, metadata-driven CRUD: describe a model once, render it in Vue, React or Angular.",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "ISC",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
