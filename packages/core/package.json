{
  "name": "@metacrud/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic metadata toolkit for describing CRUD models, forms, tables and actions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run clean && concurrently \"pnpm run build:watch\" \"pnpm run start:watch\"",
    "build": "pnpm run clean && tsc --project tsconfig.json && swc src -d dist && rollup -c rollup.config.js && rimraf dist/dts",
    "build:watch": "swc -w src -d dist",
    "start": "node dist/index.js",
    "start:watch": "nodemon --watch \"dist/**/*\" -e js ./dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --project tsconfig.json --noEmit --emitDeclarationOnly false --incremental false"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "reflect-metadata": "^0.1.13",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.15.3",
    "@types/lodash": "^4.14.201",
    "@types/node": "^20.14.10",
    "concurrently": "^8.2.2",
    "gts": "^5.2.0",
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.5",
    "rollup": "^4.18.0",
    "rollup-plugin-dts": "^6.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/amirmf404/metacrud.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/amirmf404/metacrud/issues"
  },
  "homepage": "https://github.com/amirmf404/metacrud#readme",
  "author": "",
  "license": "ISC"
}
